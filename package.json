{
  "name": "gitcrest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "frontend:dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && electron-vite build",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "pnpm build && cargo fmt --manifest-path crates/gitcrest-core/Cargo.toml --check && cargo build --manifest-path crates/gitcrest-core/Cargo.toml && pnpm test && cargo test --manifest-path crates/gitcrest-core/Cargo.toml && pnpm test:e2e",
    "api:types": "openapi-typescript doc/api/v1.yaml -o src/api/schema.ts",
    "frontend:build": "tsc && vite build",
    "preview": "vite preview",
    "frontend:preview": "vite preview",
    "core:dev": "cargo run --manifest-path crates/gitcrest-core/Cargo.toml",
    "core:build": "cargo build --manifest-path crates/gitcrest-core/Cargo.toml --release",
    "electron:dev": "electron-vite dev",
    "electron:build": "pnpm core:build && tsc --noEmit && electron-vite build",
    "electron:package": "pnpm electron:build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.lewis.gitcrest",
    "productName": "GitCrest",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "crates/gitcrest-core/target/release/gitcrest-core.exe",
        "to": "bin/gitcrest-core.exe",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
