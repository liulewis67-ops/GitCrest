{
  "name": "gitcrest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "debug": "node scripts/debug.mjs",
    "debug:core": "node scripts/debug.mjs --core-only",
    "frontend:dev": "vite",
    "frontend:boundaries": "node scripts/check-frontend-import-boundaries.mjs",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && electron-vite build",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "pnpm frontend:boundaries && pnpm build && cargo fmt --manifest-path crates/gitcrest-core/Cargo.toml --check && cargo build --manifest-path crates/gitcrest-core/Cargo.toml && pnpm test && cargo test --manifest-path crates/gitcrest-core/Cargo.toml && pnpm test:e2e",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "icons:export": "node scripts/export-app-icons.mjs",
    "api:types": "openapi-typescript doc/api/v1.yaml -o src/api/schema.ts",
    "frontend:build": "tsc && vite build",
    "preview": "vite preview",
    "frontend:preview": "vite preview",
    "core:dev": "cargo run --manifest-path crates/gitcrest-core/Cargo.toml",
    "core:build": "cargo build --manifest-path crates/gitcrest-core/Cargo.toml --release",
    "electron:dev": "electron-vite dev --watch",
    "electron:build": "pnpm core:build && tsc --noEmit && electron-vite build",
    "electron:package": "pnpm electron:build && electron-builder",
    "electron:package:windows-release": "pnpm electron:build && electron-builder --config electron-builder.desktop-release.mjs --win nsis --x64 --publish never",
    "electron:package:macos-release": "pnpm electron:build && electron-builder --config electron-builder.desktop-release.mjs --mac dmg zip --publish never",
    "electron:package:linux-release": "pnpm electron:build && electron-builder --config electron-builder.linux-release.mjs --linux AppImage --x64 --publish never",
    "release:sign-linux-update-manifest": "node scripts/sign-linux-update-manifest.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@willbooster/tree-sitter-javascript": "^2.0.3",
    "@willbooster/tree-sitter-rust": "^1.10.3",
    "@willbooster/tree-sitter-typescript": "^2.0.7",
    "@willbooster/web-tree-sitter": "^1.3.0",
    "electron-updater": "6.8.10",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "js-yaml": "4.3.2",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.lewis.gitcrest",
    "productName": "GitCrest",
    "files": [
      "out/**"
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "crates/gitcrest-core/target/release/gitcrest-core.exe",
          "to": "bin/gitcrest-core.exe"
        }
      ]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "extraResources": [
        {
          "from": "crates/gitcrest-core/target/release/gitcrest-core",
          "to": "bin/gitcrest-core"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "extraResources": [
        {
          "from": "crates/gitcrest-core/target/release/gitcrest-core",
          "to": "bin/gitcrest-core"
        }
      ]
    }
  }
}
